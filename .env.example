# Never prefix server credentials with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# JSON service-account credentials; never commit actual values.
GOOGLE_SERVICE_ACCOUNT_JSON=
# For Agent Platform express-mode API-key authentication instead:
GOOGLE_CLOUD_API_KEY=
LLM_SYNTHESIS_MODEL=gemini-3.8-flash
LLM_EXTRACTION_MODEL=gemini-3.7-flash
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
WORKER_SECRET=
ADMIN_USER_IDS=
APP_URL=http://localhost:3000
# Local Chromium path for PDF development. Vercel uses bundled Chromium.
CHROMIUM_EXECUTABLE_PATH=
